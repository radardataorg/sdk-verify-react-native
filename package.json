{
  "name": "@radardata/verify-react-native",
  "version": "0.1.3",
  "description": "RadarData Verify dentro do seu app React Native: prova de vida e coleta de dados, com fallback em WebView.",
  "license": "MIT",
  "homepage": "https://radardata.com.br",
  "keywords": [
    "radardata",
    "verify",
    "kyc",
    "liveness",
    "react-native",
    "biometria"
  ],
  "author": "RadarData",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "react-native": "./dist/esm/index.js",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./nucleo": {
      "react-native": "./dist/esm/nucleo/index.js",
      "import": {
        "types": "./dist/esm/nucleo/index.d.ts",
        "default": "./dist/esm/nucleo/index.js"
      },
      "require": {
        "types": "./dist/cjs/nucleo/index.d.ts",
        "default": "./dist/cjs/nucleo/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "nucleo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"const fs=require('fs');fs.writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}));fs.writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}))\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-webview": "13.12.4",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
