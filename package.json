{
  "name": "@radardata/verify-react-native",
  "version": "0.1.1",
  "description": "RadarData Verify dentro do seu app React Native: prova de vida e coleta de dados, com fallback em WebView.",
  "license": "MIT",
  "homepage": "https://radardata.com.br",
  "keywords": [
    "radardata",
    "verify",
    "kyc",
    "liveness",
    "react-native",
    "biometria"
  ],
  "author": "RadarData",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-webview": "13.12.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
